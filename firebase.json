{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22",
      "ignore": ["node_modules", ".git", "**/*.log", "**/.*"]
    }
  ],
  "hosting": {
    "public": "build/client",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {"source": "/v1/**", "function": "api"},
      {"source": "**", "function": "ssr"}
    ]
  },
  "emulators": {
    "auth": {"port": 9230},
    "firestore": {"port": 9231},
    "functions": {"port": 9232},
    "ui": {"enabled": true, "port": 9233},
    "hub": {"port": 9234},
    "singleProjectMode": true
  }
}
