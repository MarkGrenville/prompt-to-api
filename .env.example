# Public (exposed to the browser) ------------------------------------------
PUBLIC_APP_ENV=development
PUBLIC_USE_EMULATOR=true

# Firebase web config (safe to expose). Fill after `firebase apps:sdkconfig web`.
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=prompt-to-api
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=

# Emulator hosts (used when PUBLIC_USE_EMULATOR=true)
PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=http://localhost:9230
PUBLIC_FIRESTORE_EMULATOR_HOST=localhost:9231

# Server-only ---------------------------------------------------------------
# 32-byte hex secret used to AES-256-GCM encrypt LLM provider keys at rest.
# Generate: `openssl rand -hex 32`
KEY_ENCRYPTION_SECRET=

# Firebase admin (only needed for production SSR; emulator auto-detects).
# Provide JSON service-account credentials path OR inline via ADMIN_* vars.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
ADMIN_PROJECT_ID=prompt-to-api
ADMIN_CLIENT_EMAIL=
ADMIN_PRIVATE_KEY=

# Emulator hosts (server-side SDKs read these automatically)
FIRESTORE_EMULATOR_HOST=localhost:9231
FIREBASE_AUTH_EMULATOR_HOST=localhost:9230
